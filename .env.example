# API Keys (Required)
GEMINI_API_KEY=your_gemini_api_key_here
SEGMIND_API_KEY=your_segmind_api_key_here

# Model Configuration
DEFAULT_MODEL=2

# Database Configuration
SQLITE_DB_PATH=myntra.db
CHROMADB_PATH=chroma_db

# File Directories
FITTED_IMAGES_FOLDER=fitted_images
EXTRACTED_CLOTH_IMAGES_FOLDER=extracted_cloth_images
SOURCE_FOLDER=source_images
USER_IMAGES_FOLDER=user_images

# For Vercel deployment, make sure to set these environment variables
# in your Vercel dashboard under Project Settings > Environment Variables