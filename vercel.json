{
  "version": 2,
  "builds": [
    {
      "src": "back/backend/app.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend-next/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "back/backend/app.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend-next/$1"
    }
  ],
  "env": {
    "GEMINI_API_KEY": "@gemini_api_key",
    "SEGMIND_API_KEY": "@segmind_api_key"
  }
}