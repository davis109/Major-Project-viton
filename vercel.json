{
  "version": 2,
  "buildCommand": "cd frontend-next && npm install && npm run build",
  "outputDirectory": "frontend-next/.next",
  "framework": "nextjs",
  "builds": [
    {
      "src": "back/backend/app.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "back/backend/app.py"
    }
  ],
  "functions": {
    "back/backend/app.py": {
      "memory": 3008,
      "maxDuration": 60
    }
  }
}